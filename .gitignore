# Git ignore rules for Auto_OTO
#
# Goal: include source code only, exclude datasets/docs/venv/cache/build/runtime artifacts.

# 1) Ignore everything by default
*

# 2) Keep directory traversal so allowlist rules below can work
!*/

# 3) Keep repo metadata and essential root-level source configs
!.gitignore
!.gitignore.public
!.gitattributes
!LICENSE
!main.py
!build.py
!build_pyinstaller_beta.py
!pytest.ini
!requirements.txt
!requirements-ml.txt
!setup_mfa.bat
!setup_mfa_beta.bat
!run_prepare_pairs.ps1
!UTAU_Auto_OTO.spec
!release_channel.json
!AGENTS.md
!plans/
!plans/**

# 4) Keep source directories
!core/
!core/**
!ui/
!ui/**
!ml/
!ml/**
!scripts/
!scripts/**
!tests/
!tests/**
!.github/
!.github/**

# 5) Exclude non-code/data-heavy content even under kept trees
ml/notebooks/
ml/notebooks/**
*.ipynb

# A/B listening run output is per-cycle data, not source.
# Manifests, labels CSV, and reports stay tracked; only runs/<run_id>/<version>/<voicebank>/oto.ini
# and the per-run summary are gitignored.
ml/eval/ab_listening/runs/**
!ml/eval/ab_listening/runs/.gitkeep

# 6) Explicitly exclude local artifacts and private/training data roots
.cache/
.venv/
.env/
__pycache__/
logs/
build_assets/
bundle_info.json
installer_output/
UTAU_Auto_OTO_Release*/
release_assets/
Docs/
dataset/
dataset_staged/
custom_test_wavs/
test_wavs/
experiments/
plan/
ml_workspace/
ML_models/
models_installed/

# 7) Common binary/media artifacts
*.wav
*.flac
*.mp3
*.TextGrid
*.lab
*.ckpt
*.pt
*.pth
*.onnx
*.npz
*.joblib
*.pkl
*.pickle
*.zip
*.7z
*.tar
*.tar.gz
/micromamba
/temp
/.code-review-graph
/code-review-graph
/.claude

# 8) IDE / editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.orig

# 9) OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# 10) Python build & test artifacts
dist/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
*.egg
MANIFEST

# 11) Nuitka build output
*.dist/
*.build/
*.onefile-build/
/ml/eval
